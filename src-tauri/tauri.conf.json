{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebulosa Companion",
  "version": "0.1.0",
  "identifier": "com.instrix.nebulosa.companion",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nebulosa Companion",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-nebulosa.rules": "../udev/99-nebulosa.rules"
        }
      }
    }
  }
}
