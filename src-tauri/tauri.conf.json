{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebulosa Companion",
  "version": "0.2.1",
  "identifier": "com.instrix.nebulosa.companion",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nebulosa Companion",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "backgroundColor": "#161826"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "INSTRIX",
    "category": "DeveloperTool",
    "shortDescription": "Companion app for the INSTRIX Nebulosa power profiler",
    "longDescription": "Scope, logger, analysis, serial monitor and side-channel tools for the INSTRIX Nebulosa power profiler (USB and Ethernet), with a built-in demo device.",
    "copyright": "© INSTRIX",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-nebulosa.rules": "../udev/99-nebulosa.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/99-nebulosa.rules": "../udev/99-nebulosa.rules"
        }
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
